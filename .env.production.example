# Server-side .env for docker-compose.prod.yml (cp .env.production.example .env). Never commit .env.
# The public stack is read-only (DEMO_MODE=1) and does NOT need OPENAI_API_KEY: generate the data on your own machine.

# Base domain. Caddy serves https://<domain> (dashboard), https://api.<domain> and https://store.<domain>.
# Create three DNS A records (or one wildcard *.<domain>) pointing to the server.
AGENTLENS_DOMAIN=agentlens.ptlabs.in

# Generate each with:  openssl rand -hex 24
AGENTLENS_IP_SALT=
AGENTLENS_ADMIN_PASSWORD=

AGENTLENS_STORE_NAME=Desi Threads
AGENTLENS_LLM_PROVIDER=off

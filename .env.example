# AgentLens configuration. Copy to .env (tasks.ps1 setup / make setup does this). Never commit .env.
# All values below are safe placeholders; the demo works without changing any of them.

# --- Store (apps/store) ---
# Salt for ip_hash / cookie_sid_hash. Rotating it breaks session linkage. Outside --dev the store warns while this is "change-me".
AGENTLENS_IP_SALT=change-me
# Password for the store /admin page (friction toggles). Disabled when DEMO_MODE=1.
AGENTLENS_ADMIN_PASSWORD=change-me
# Also write <data>/logs/access.nginx.log (nginx combined format) next to the JSONL log.
AGENTLENS_NGINX_LOG=0
# Copy the X-Synth-Session header into the log. Only for synthetic traffic; leave 0 for real traffic.
AGENTLENS_SYNTH_MODE=0
# Store bind address (defaults 3100 / 127.0.0.1; use HOST=0.0.0.0 in containers):
# PORT=3100
# HOST=127.0.0.1

# --- LLM layer (optional). mock = deterministic, no network, no key needed. openai needs OPENAI_API_KEY (ADR-001). ---
AGENTLENS_LLM_PROVIDER=mock
OPENAI_API_KEY=
AGENTLENS_LLM_MODEL=gpt-4o-mini
# Upper bound of sessions sent to the LLM classifier per diagnose run.
AGENTLENS_LLM_MAX_SESSIONS=200

# --- Replay agent and site checks ---
# Tunnel host (host[:port]) added to the replay allow-list for real-agent runs, e.g. my-store.trycloudflare.com
PUBLIC_STORE_HOST=
# Store the pipeline probes (robots.txt, JSON-LD, size guide, ...) in the diagnose step. Unset = site checks skipped.
# Set it while the store is running; tasks.ps1 demo sets it for you.
# AGENTLENS_SITE_URL=http://localhost:3100
# Display name for the store in the dashboard header.
# AGENTLENS_STORE_NAME=Desi Threads

# --- Services ---
STORE_URL=http://localhost:3100
API_URL=http://localhost:8100
DASHBOARD_URL=http://localhost:3101
# 1 = read-only: store /admin disabled, API reports demo_mode. The static dashboard build is switched separately (below).
DEMO_MODE=0
# Dashboard build/dev settings are read from the shell or apps/dashboard/.env.local, not from this file:
#   NEXT_PUBLIC_API_URL=http://localhost:8100/api   API base URL (default)
#   NEXT_PUBLIC_DEMO_MODE=1 (or DEMO_MODE=1)        static snapshot under /demo/*.json instead of the API
#   NEXT_PUBLIC_USE_MOCKS=1                         in-browser fixtures (UI development only)
# --- Data ---
# Where the store writes JSONL logs and where the pipeline reads them and keeps agentlens.duckdb (relative = repo root).
AGENTLENS_DATA_DIR=./data
# Optional overrides: AGENTLENS_DB_PATH (DuckDB file), AGENTLENS_CONFIG_DIR (default ./config), AGENTLENS_DEFAULT_HOST (host for nginx logs without one)

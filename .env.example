AGENTLENS_IP_SALT=change-me
AGENTLENS_ADMIN_PASSWORD=change-me
# Optional LLM layer. Empty key = rules-only mode (everything still works).
AGENTLENS_LLM_PROVIDER=mock        # mock | openai
OPENAI_API_KEY=
AGENTLENS_LLM_MODEL=gpt-4o-mini
AGENTLENS_LLM_MAX_SESSIONS=200
AGENTLENS_SYNTH_MODE=0
PUBLIC_STORE_HOST=                 # tunnel host for real-agent runs
STORE_URL=http://localhost:3100
API_URL=http://localhost:8100
DASHBOARD_URL=http://localhost:3101
DEMO_MODE=0
# Where the store writes JSONL logs and where the pipeline reads them
AGENTLENS_DATA_DIR=./data
